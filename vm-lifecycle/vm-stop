#!/bin/bash
# Stop Portable Claude Code VM
#
# This script stops the VM (GCP or Vultr) to save costs.
#
# Usage: ./vm-stop [provider]
#
# Environment variables:
#   CLOUD_PROVIDER=gcp|vultr

set -euo pipefail

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

# Get script directory
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CONFIG_FILE="$SCRIPT_DIR/../cloud-providers/config.sh"

# Source provider config
if [[ -f "$CONFIG_FILE" ]]; then
    source "$CONFIG_FILE"
else
    export CLOUD_PROVIDER="${CLOUD_PROVIDER:-gcp}"
fi

PROVIDER="${1:-${CLOUD_PROVIDER:-gcp}}"
export CLOUD_PROVIDER="$PROVIDER"
source "$CONFIG_FILE"

# Helper functions
log_info() { echo -e "${BLUE}[INFO]${NC} $1"; }
log_success() { echo -e "${GREEN}[SUCCESS]${NC} $1"; }
log_warning() { echo -e "${YELLOW}[WARNING]${NC} $1"; }
log_error() { echo -e "${RED}[ERROR]${NC} $1"; }

# Provider-specific functions
gcp_stop_vm() {
    local project_id="$1"
    local zone="$2"
    local instance_name="$3"

    if ! command -v gcloud &> /dev/null; then
        log_error "gcloud CLI not found."
        return 1
    fi

    # Check status
    local status
    status=$(gcloud compute instances describe "$instance_name" \
        --zone="$zone" \
        --project="$project_id" \
        --format="value(status)" 2>/dev/null || echo "NOT_FOUND")

    case "$status" in
        TERMINATED|STOPPED)
            log_success "VM is already stopped."
            return 0
            ;;
        NOT_FOUND)
            log_error "VM not found."
            return 1
            ;;
        *)
            # Proceed with stop
            ;;
    esac

    # Stop the VM
    log_info "Stopping VM..."
    gcloud compute instances stop "$instance_name" \
        --zone="$zone" \
        --project="$project_id"
}

vultr_stop_vm() {
    local instance_name="$1"

    if ! command -v jq &> /dev/null; then
        log_error "jq not found. Install: brew install jq"
        return 1
    fi

    if [[ -z "${VULTR_API_KEY:-}" ]]; then
        log_error "VULTR_API_KEY not set."
        return 1
    fi

    # Get instances
    local instances
    instances=$(curl -s -X GET \
        "${VULTR_API_BASE}/instances" \
        -H "Authorization: Bearer ${VULTR_API_KEY}")

    local instance_id
    instance_id=$(echo "$instances" | jq -r ".instances[] | select(.label == \"${instance_name}\") | .id" 2>/dev/null || echo "")

    if [[ -z "$instance_id" ]]; then
        log_error "VM not found."
        return 1
    fi

    # Get status
    local status
    status=$(echo "$instances" | jq -r ".instances[] | select(.label == \"${instance_name}\") | .status")

    case "$status" in
        stopped)
            log_success "VM is already stopped."
            return 0
            ;;
        *)
            # Proceed with stop
            ;;
    esac

    # Stop the VM
    log_info "Stopping VM..."
    curl -s -X POST \
        "${VULTR_API_BASE}/instances/${instance_id}/halt" \
        -H "Authorization: Bearer ${VULTR_API_KEY}" > /dev/null
}

# Main
echo -e "${YELLOW}"
echo "=================================="
echo "Portable CC - Stop VM"
echo "=================================="
echo -e "${NC}"
echo "Provider:  $PROVIDER_NAME ($CLOUD_PROVIDER)"
echo "Instance:  $INSTANCE_NAME"
echo ""

# Confirm
read -p "Stop VM '$INSTANCE_NAME'? (y/N): " -n 1 -r
echo ""
if [[ ! $REPLY =~ ^[Yy]$ ]]; then
    log_info "Cancelled."
    exit 0
fi

# Stop the VM
case "$CLOUD_PROVIDER" in
    gcp)
        if ! gcp_stop_vm "$PROJECT_ID" "$ZONE" "$INSTANCE_NAME"; then
            exit 1
        fi
        ;;
    vultr)
        if ! vultr_stop_vm "$INSTANCE_NAME"; then
            exit 1
        fi
        ;;
    *)
        log_error "Unknown provider: $CLOUD_PROVIDER"
        exit 1
        ;;
esac

log_success "VM stopped."

# Show cost savings
echo ""
echo -e "${GREEN}=================================="
echo "Cost Savings"
echo "==================================${NC}"
echo ""
echo "VM is now stopped. You're no longer being charged!"
echo ""
echo "To start again:"
echo "  ./vm-start"
echo ""
