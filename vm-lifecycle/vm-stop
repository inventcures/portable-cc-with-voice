#!/bin/bash
# Stop Portable Claude Code VM
#
# This script stops the GCP VM to save costs.
#
# Usage: ./vm-stop [PROJECT_ID] [ZONE] [INSTANCE_NAME]
#
# Environment variables can also be used:
#   GCP_PROJECT_ID, GCP_ZONE, GCP_INSTANCE_NAME

set -euo pipefail

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

# Configuration (from args or env or defaults)
PROJECT_ID="${1:-${GCP_PROJECT_ID:-portable-cc-dev}}"
ZONE="${2:-${GCP_ZONE:-us-central1-a}}"
INSTANCE_NAME="${3:-${GCP_INSTANCE_NAME:-portable-cc-dev}}"
SERVICE_ACCOUNT_KEY="${GOOGLE_APPLICATION_CREDENTIALS:-}"

# Helper functions
log_info() {
    echo -e "${BLUE}[INFO]${NC} $1"
}

log_success() {
    echo -e "${GREEN}[SUCCESS]${NC} $1"
}

log_warning() {
    echo -e "${YELLOW}[WARNING]${NC} $1"
}

log_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

echo -e "${YELLOW}"
echo "=================================="
echo "Portable CC - Stop VM"
echo "=================================="
echo -e "${NC}"
echo "Project:   $PROJECT_ID"
echo "Zone:      $ZONE"
echo "Instance:  $INSTANCE_NAME"
echo ""

# Check for service account key
if [[ -n "$SERVICE_ACCOUNT_KEY" && -f "$SERVICE_ACCOUNT_KEY" ]]; then
    export GOOGLE_APPLICATION_CREDENTIALS="$SERVICE_ACCOUNT_KEY"
fi

# Check current VM status
log_info "Checking VM status..."
STATUS=$(gcloud compute instances describe "$INSTANCE_NAME" \
    --zone="$ZONE" \
    --project="$PROJECT_ID" \
    --format="value(status)" 2>/dev/null || echo "NOT_FOUND")

case "$STATUS" in
    TERMINATED|STOPPED)
        log_success "VM is already stopped."
        exit 0
        ;;
    NOT_FOUND)
        log_error "VM not found."
        exit 1
        ;;
    RUNNING)
        # Proceed with stop
        ;;
    *)
        log_warning "VM status: $STATUS"
        ;;
esac

# Confirm before stopping
read -p "Stop VM '$INSTANCE_NAME'? (y/N): " -n 1 -r
echo ""
if [[ ! $REPLY =~ ^[Yy]$ ]]; then
    log_info "Cancelled."
    exit 0
fi

# Stop the VM
log_info "Stopping VM..."
gcloud compute instances stop "$INSTANCE_NAME" \
    --zone="$ZONE" \
    --project="$PROJECT_ID"

log_success "VM stopped."

# Show cost savings
echo ""
echo -e "${GREEN}=================================="
echo "Cost Savings"
echo "==================================${NC}"
echo ""
echo "VM is now stopped. You're no longer being charged!"
echo ""
echo "To start again:"
echo "  ./vm-start"
echo ""
echo "Or from iOS Shortcuts: Start Dev VM"
echo ""
