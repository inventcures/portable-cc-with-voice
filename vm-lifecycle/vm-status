#!/bin/bash
# Check Portable Claude Code VM Status
#
# This script shows the current status of the VM (GCP or Vultr).
#
# Usage: ./vm-status [provider]
#
# Environment variables:
#   CLOUD_PROVIDER=gcp|vultr

set -euo pipefail

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

# Get script directory
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CONFIG_FILE="$SCRIPT_DIR/../cloud-providers/config.sh"

# Source provider config
if [[ -f "$CONFIG_FILE" ]]; then
    source "$CONFIG_FILE"
else
    export CLOUD_PROVIDER="${CLOUD_PROVIDER:-gcp}"
fi

PROVIDER="${1:-${CLOUD_PROVIDER:-gcp}}"
export CLOUD_PROVIDER="$PROVIDER"
source "$CONFIG_FILE"

# Helper functions
log_info() { echo -e "${BLUE}[INFO]${NC} $1"; }
log_success() { echo -e "${GREEN}[SUCCESS]${NC} $1"; }
log_warning() { echo -e "${YELLOW}[WARNING]${NC} $1"; }
log_error() { echo -e "${RED}[ERROR]${NC} $1"; }

# Provider-specific functions
gcp_get_status() {
    local project_id="$1"
    local zone="$2"
    local instance_name="$3"

    if ! command -v gcloud &> /dev/null; then
        log_error "gcloud CLI not found."
        return 1
    fi

    local status
    status=$(gcloud compute instances describe "$instance_name" \
        --zone="$zone" \
        --project="$project_id" \
        --format="value(status)" 2>/dev/null || echo "NOT_FOUND")

    if [[ "$status" == "NOT_FOUND" ]]; then
        echo "NOT_FOUND"
        return 1
    fi

    echo "$status"

    # Get machine type
    local machine_type
    machine_type=$(gcloud compute instances describe "$instance_name" \
        --zone="$zone" \
        --project="$project_id" \
        --format="value(machineType)" | sed 's/.*\///')

    echo "MACHINE_TYPE:$machine_type"

    # Get internal IP
    local internal_ip
    internal_ip=$(gcloud compute instances describe "$instance_name" \
        --zone="$zone" \
        --project="$project_id" \
        --format="value(networkInterfaces[0].networkIP)")

    echo "INTERNAL_IP:$internal_ip"
}

vultr_get_status() {
    local instance_name="$1"

    if ! command -v jq &> /dev/null; then
        log_error "jq not found. Install: brew install jq"
        return 1
    fi

    if [[ -z "${VULTR_API_KEY:-}" ]]; then
        log_error "VULTR_API_KEY not set."
        return 1
    fi

    local instances
    instances=$(curl -s -X GET \
        "${VULTR_API_BASE}/instances" \
        -H "Authorization: Bearer ${VULTR_API_KEY}")

    local instance_id
    instance_id=$(echo "$instances" | jq -r ".instances[] | select(.label == \"${instance_name}\") | .id" 2>/dev/null || echo "")

    if [[ -z "$instance_id" ]]; then
        echo "NOT_FOUND"
        return 1
    fi

    local status
    status=$(echo "$instances" | jq -r ".instances[] | select(.label == \"${instance_name}\") | .status")
    echo "$status"

    # Get plan (machine type)
    local plan
    plan=$(echo "$instances" | jq -r ".instances[] | select(.label == \"${instance_name}\") | .plan")
    echo "MACHINE_TYPE:$plan"

    # Get main IP
    local main_ip
    main_ip=$(echo "$instances" | jq -r ".instances[] | select(.label == \"${instance_name}\") | .main_ip")
    echo "MAIN_IP:$main_ip"
}

# Main
echo -e "${BLUE}"
echo "=================================="
echo "Portable CC - VM Status"
echo "=================================="
echo -e "${NC}"
echo "Provider:  $PROVIDER_NAME ($CLOUD_PROVIDER)"
echo "Instance:  $INSTANCE_NAME"
echo ""

# Get status
case "$CLOUD_PROVIDER" in
    gcp)
        STATUS_INFO=$(gcp_get_status "$PROJECT_ID" "$ZONE" "$INSTANCE_NAME" 2>&1) || true
        ;;
    vultr)
        STATUS_INFO=$(vultr_get_status "$INSTANCE_NAME" 2>&1) || true
        ;;
    *)
        log_error "Unknown provider: $CLOUD_PROVIDER"
        exit 1
        ;;
esac

# Parse status
STATUS=$(echo "$STATUS_INFO" | head -1)
MACHINE_TYPE=$(echo "$STATUS_INFO" | grep "MACHINE_TYPE:" | cut -d: -f2)
INTERNAL_IP=$(echo "$STATUS_INFO" | grep "INTERNAL_IP:" | cut -d: -f2)
MAIN_IP=$(echo "$STATUS_INFO" | grep "MAIN_IP:" | cut -d: -f2)

if [[ "$STATUS" == "NOT_FOUND" ]]; then
    log_error "VM not found."
    echo ""
    echo "Create the VM first:"
    case "$CLOUD_PROVIDER" in
        gcp) echo "  ./cloud-providers/gcp/create-vm.sh $PROJECT_ID $ZONE $INSTANCE_NAME" ;;
        vultr) echo "  ./cloud-providers/vultr/create-vm.sh" ;;
    esac
    exit 1
fi

# Display status
echo -n "Status: "
if [[ "$STATUS" == "RUNNING" || "$STATUS" == "active" ]]; then
    echo -e "${GREEN}$STATUS${NC}"
else
    echo -e "${YELLOW}$STATUS${NC}"
fi
echo ""

# Show details if running
if [[ "$STATUS" == "RUNNING" || "$STATUS" == "active" ]]; then
    echo "VM Details:"
    echo "  Type: ${MACHINE_TYPE:-unknown}"
    if [[ -n "${INTERNAL_IP:-}" ]]; then
        echo "  Internal IP: $INTERNAL_IP"
    fi
    if [[ -n "${MAIN_IP:-}" ]]; then
        echo "  Main IP: $MAIN_IP"
    fi
    echo ""

    # Check Tailscale
    if [[ -n "${TAILSCALE_HOST:-}" ]]; then
        echo "Tailscale:"
        echo "  Host: $TAILSCALE_HOST"
        if ssh -o ConnectTimeout=3 -o StrictHostKeyChecking=no "${SSH_USER:-ubuntu}@${TAILSCALE_HOST}" "echo OK" &>/dev/null; then
            echo "  Status: ${GREEN}Connected${NC}"
        else
            echo "  Status: ${YELLOW}Not responding${NC}"
        fi
    fi

    echo ""
    echo "Connect:"
    echo "  ./vm-start"
fi

# Show cost estimate
echo ""
echo -e "${BLUE}Cost Estimate:${NC}"
if [[ "$STATUS" == "RUNNING" || "$STATUS" == "active" ]]; then
    echo "  Provider ($CLOUD_PROVIDER): ~\$${COST_PER_HOUR}/hour"
    echo "  ~\$$(echo "$COST_PER_HOUR * 730" | bc 2>/dev/null || echo "~22-37")/month if running 24/7"
    echo ""
    echo "  ${YELLOW}Stop when not in use to save costs:${NC}"
    echo "  ./vm-stop"
else
    echo "  ${GREEN}VM is stopped - no charges!${NC}"
fi

echo ""
