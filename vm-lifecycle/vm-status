#!/bin/bash
# Check Portable Claude Code VM Status
#
# This script shows the current status of the GCP VM.
#
# Usage: ./vm-status [PROJECT_ID] [ZONE] [INSTANCE_NAME]

set -euo pipefail

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

# Configuration
PROJECT_ID="${1:-${GCP_PROJECT_ID:-portable-cc-dev}}"
ZONE="${2:-${GCP_ZONE:-us-central1-a}}"
INSTANCE_NAME="${3:-${GCP_INSTANCE_NAME:-portable-cc-dev}}"

# Helper functions
log_info() {
    echo -e "${BLUE}[INFO]${NC} $1"
}

log_success() {
    echo -e "${GREEN}[SUCCESS]${NC} $1"
}

log_warning() {
    echo -e "${YELLOW}[WARNING]${NC} $1"
}

log_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

echo -e "${BLUE}"
echo "=================================="
echo "Portable CC - VM Status"
echo "=================================="
echo -e "${NC}"
echo "Project:   $PROJECT_ID"
echo "Zone:      $ZONE"
echo "Instance:  $INSTANCE_NAME"
echo ""

# Get VM status
STATUS=$(gcloud compute instances describe "$INSTANCE_NAME" \
    --zone="$ZONE" \
    --project="$PROJECT_ID" \
    --format="value(status)" 2>/dev/null || echo "NOT_FOUND")

if [[ "$STATUS" == "NOT_FOUND" ]]; then
    log_error "VM not found."
    echo ""
    echo "Create the VM first:"
    echo "  ./gcp/create-vm.sh $PROJECT_ID $ZONE $INSTANCE_NAME"
    exit 1
fi

# Display status
echo "Status: ${GREEN}$STATUS${NC}"
echo ""

# Get more details if running
if [[ "$STATUS" == "RUNNING" ]]; then
    echo "VM Details:"
    gcloud compute instances describe "$INSTANCE_NAME" \
        --zone="$ZONE" \
        --project="$PROJECT_ID" \
        --format="value(machineType)" | sed 's/projects.*\/machines\//  Type: /'
    gcloud compute instances describe "$INSTANCE_NAME" \
        --zone="$ZONE" \
        --project="$PROJECT_ID" \
        --format="value(networkInterfaces[0].networkIP)" | sed 's/^/  Internal IP: /'
    echo ""

    # Check if Tailscale is responding (if host is set)
    if [[ -n "${TAILSCALE_HOST:-}" ]]; then
        echo "Tailscale:"
        echo "  Host: $TAILSCALE_HOST"
        if ssh -o ConnectTimeout=3 -o StrictHostKeyChecking=no "${SSH_USER:-ubuntu}@${TAILSCALE_HOST}" "echo OK" &>/dev/null; then
            echo "  Status: ${GREEN}Connected${NC}"
        else
            echo "  Status: ${YELLOW}Not responding${NC}"
        fi
    fi

    echo ""
    echo "Connect:"
    echo "  ./vm-start"
fi

# Show estimated cost
echo ""
echo -e "${BLUE}Cost Estimate:${NC}"
if [[ "$STATUS" == "RUNNING" ]]; then
    echo "  e2-medium: ~\$0.05/hour"
    echo "  ~\$36/month if running 24/7"
    echo ""
    echo "  ${YELLOW}Stop when not in use to save costs:${NC}"
    echo "  ./vm-stop"
else
    echo "  ${GREEN}VM is stopped - no charges!${NC}"
fi

echo ""
