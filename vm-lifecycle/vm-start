#!/bin/bash
# Start Portable Claude Code VM and Connect
#
# This script starts the GCP VM, waits for Tailscale connectivity,
# and then connects via mosh.
#
# Usage: ./vm-start [PROJECT_ID] [ZONE] [INSTANCE_NAME]
#
# Environment variables can also be used:
#   GCP_PROJECT_ID, GCP_ZONE, GCP_INSTANCE_NAME, TAILSCALE_HOST, SSH_USER

set -euo pipefail

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

# Configuration (from args or env or defaults)
PROJECT_ID="${1:-${GCP_PROJECT_ID:-portable-cc-dev}}"
ZONE="${2:-${GCP_ZONE:-us-central1-a}}"
INSTANCE_NAME="${3:-${GCP_INSTANCE_NAME:-portable-cc-dev}}"
TAILSCALE_HOST="${TAILSCALE_HOST:-}"
SSH_USER="${SSH_USER:-ubuntu}"
SERVICE_ACCOUNT_KEY="${GOOGLE_APPLICATION_CREDENTIALS:-}"

# Timeouts
START_TIMEOUT=300  # 5 minutes max wait for VM to start
SSH_TIMEOUT=120    # 2 minutes max wait for SSH

# Helper functions
log_info() {
    echo -e "${BLUE}[INFO]${NC} $1"
}

log_success() {
    echo -e "${GREEN}[SUCCESS]${NC} $1"
}

log_warning() {
    echo -e "${YELLOW}[WARNING]${NC} $1"
}

log_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

# Check if gcloud is installed
if ! command -v gcloud &> /dev/null; then
    log_error "gcloud CLI not found. Please install from: https://cloud.google.com/sdk/docs/install"
    exit 1
fi

echo -e "${GREEN}"
echo "=================================="
echo "Portable CC - Start VM"
echo "=================================="
echo -e "${NC}"
echo "Project:   $PROJECT_ID"
echo "Zone:      $ZONE"
echo "Instance:  $INSTANCE_NAME"
echo ""

# Check for service account key
if [[ -n "$SERVICE_ACCOUNT_KEY" && -f "$SERVICE_ACCOUNT_KEY" ]]; then
    log_info "Using service account key: $SERVICE_ACCOUNT_KEY"
    export GOOGLE_APPLICATION_CREDENTIALS="$SERVICE_ACCOUNT_KEY"
elif [[ -n "$SERVICE_ACCOUNT_KEY" ]]; then
    log_warning "Service account key specified but not found: $SERVICE_ACCOUNT_KEY"
fi

# Check current VM status
log_info "Checking VM status..."
STATUS=$(gcloud compute instances describe "$INSTANCE_NAME" \
    --zone="$ZONE" \
    --project="$PROJECT_ID" \
    --format="value(status)" 2>/dev/null || echo "NOT_FOUND")

case "$STATUS" in
    RUNNING)
        log_success "VM is already running."
        ;;
    TERMINATED|STOPPED)
        log_info "VM is stopped. Starting..."
        gcloud compute instances start "$INSTANCE_NAME" \
            --zone="$ZONE" \
            --project="$PROJECT_ID"
        log_success "VM start command sent."
        ;;
    NOT_FOUND)
        log_error "VM not found. Please create it first:"
        echo "  ./gcp/create-vm.sh $PROJECT_ID $ZONE $INSTANCE_NAME"
        exit 1
        ;;
    *)
        log_warning "VM status: $STATUS (waiting for it to resolve...)"
        ;;
esac

# Wait for VM to be RUNNING
if [[ "$STATUS" != "RUNNING" ]]; then
    log_info "Waiting for VM to start (timeout: ${START_TIMEOUT}s)..."
    ELAPSED=0
    while [[ $ELAPSED -lt $START_TIMEOUT ]]; do
        STATUS=$(gcloud compute instances describe "$INSTANCE_NAME" \
            --zone="$ZONE" \
            --project="$PROJECT_ID" \
            --format="value(status)" 2>/dev/null || echo "UNKNOWN")

        if [[ "$STATUS" == "RUNNING" ]]; then
            log_success "VM is running!"
            break
        fi

        echo -n "."
        sleep 2
        ELAPSED=$((ELAPSED + 2))
    done
    echo ""

    if [[ "$STATUS" != "RUNNING" ]]; then
        log_error "VM failed to start within timeout."
        log_info "Check status manually: gcloud compute instances describe $INSTANCE_NAME --zone=$ZONE --project=$PROJECT_ID"
        exit 1
    fi
fi

# Check for Tailscale host
if [[ -z "$TAILSCALE_HOST" ]]; then
    log_warning "TAILSCALE_HOST not set."
    echo ""
    echo "Please set your Tailscale hostname or IP:"
    echo "  export TAILSCALE_HOST='your-tailscale-host-or-ip'"
    echo ""
    read -p "Enter Tailscale hostname/IP (or press Enter to skip connecting): " TAILSCALE_HOST_INPUT
    TAILSCALE_HOST="$TAILSCALE_HOST_INPUT"
fi

if [[ -z "$TAILSCALE_HOST" ]]; then
    log_info "Skipping SSH connection. VM is running."
    log_info "Connect manually when ready:"
    echo "  mosh $SSH_USER@<tailscale-ip>"
    exit 0
fi

# Wait for SSH/Tailscale to be ready
log_info "Waiting for SSH connectivity (timeout: ${SSH_TIMEOUT}s)..."
ELAPSED=0
while [[ $ELAPSED -lt $SSH_TIMEOUT ]]; do
    if ssh -o ConnectTimeout=5 -o StrictHostKeyChecking=no "$SSH_USER@$TAILSCALE_HOST" "echo ready" &>/dev/null; then
        log_success "SSH is ready!"
        break
    fi
    echo -n "."
    sleep 2
    ELAPSED=$((ELAPSED + 2))
done
echo ""

if [[ $ELAPSED -ge $SSH_TIMEOUT ]]; then
    log_warning "SSH not responding within timeout."
    log_info "VM is running but may still be booting."
    log_info "Connect manually when ready:"
    echo "  ssh $SSH_USER@$TAILSCALE_HOST"
    echo "  mosh $SSH_USER@$TAILSCALE_HOST"
    exit 0
fi

# Connect via mosh (preferred) or SSH
log_info "Connecting to $TAILSCALE_HOST..."

if command -v mosh &> /dev/null; then
    exec mosh "$SSH_USER@$TAILSCALE_HOST"
else
    log_warning "mosh not found. Using regular SSH."
    log_info "Install mosh for better network resilience."
    exec ssh "$SSH_USER@$TAILSCALE_HOST"
fi
