#!/bin/bash
# Start Portable Claude Code VM and Connect
#
# This script starts the VM (GCP or Vultr), waits for Tailscale connectivity,
# and then connects via mosh.
#
# Usage: ./vm-start [provider]
#
# Environment variables:
#   CLOUD_PROVIDER=gcp|vultr
#   TAILSCALE_HOST, SSH_USER

set -euo pipefail

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

# Timeouts
START_TIMEOUT=300  # 5 minutes max wait for VM to start
SSH_TIMEOUT=120    # 2 minutes max wait for SSH

# Get script directory
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CONFIG_FILE="$SCRIPT_DIR/../cloud-providers/config.sh"

# Source provider config
if [[ -f "$CONFIG_FILE" ]]; then
    source "$CONFIG_FILE"
else
    echo "Warning: config.sh not found at $CONFIG_FILE"
    echo "Using defaults (GCP)"
    export CLOUD_PROVIDER="${CLOUD_PROVIDER:-gcp}"
fi

# Override with command line arg
PROVIDER="${1:-${CLOUD_PROVIDER:-gcp}}"
export CLOUD_PROVIDER="$PROVIDER"

# Re-source with new provider
source "$CONFIG_FILE"

# Helper functions
log_info() { echo -e "${BLUE}[INFO]${NC} $1"; }
log_success() { echo -e "${GREEN}[SUCCESS]${NC} $1"; }
log_warning() { echo -e "${YELLOW}[WARNING]${NC} $1"; }
log_error() { echo -e "${RED}[ERROR]${NC} $1"; }

# Provider-specific functions
gcp_start_vm() {
    local project_id="$1"
    local zone="$2"
    local instance_name="$3"

    if ! command -v gcloud &> /dev/null; then
        log_error "gcloud CLI not found."
        return 1
    fi

    # Check status
    local status
    status=$(gcloud compute instances describe "$instance_name" \
        --zone="$zone" \
        --project="$project_id" \
        --format="value(status)" 2>/dev/null || echo "NOT_FOUND")

    case "$status" in
        RUNNING)
            log_success "VM is already running."
            return 0
            ;;
        TERMINATED|STOPPED)
            log_info "VM is stopped. Starting..."
            gcloud compute instances start "$instance_name" \
                --zone="$zone" \
                --project="$project_id"
            log_success "VM start command sent."
            ;;
        NOT_FOUND)
            log_error "VM not found. Create it first:"
            echo "  ./cloud-providers/gcp/create-vm.sh $project_id $zone $instance_name"
            return 1
            ;;
        *)
            log_warning "VM status: $status"
            ;;
    esac

    # Wait for RUNNING
    if [[ "$status" != "RUNNING" ]]; then
        log_info "Waiting for VM to start..."
        local elapsed=0
        while [[ $elapsed -lt $START_TIMEOUT ]]; do
            status=$(gcloud compute instances describe "$instance_name" \
                --zone="$zone" \
                --project="$project_id" \
                --format="value(status)" 2>/dev/null || echo "UNKNOWN")

            if [[ "$status" == "RUNNING" ]]; then
                log_success "VM is running!"
                return 0
            fi

            echo -n "."
            sleep 2
            elapsed=$((elapsed + 2))
        done
        echo ""
        log_error "VM failed to start within timeout."
        return 1
    fi
}

vultr_start_vm() {
    local instance_name="$1"

    if ! command -v jq &> /dev/null; then
        log_error "jq not found. Install: brew install jq"
        return 1
    fi

    if [[ -z "${VULTR_API_KEY:-}" ]]; then
        log_error "VULTR_API_KEY not set."
        echo "Run: ./cloud-providers/vultr/setup.sh"
        return 1
    fi

    # Get instances
    local instances
    instances=$(curl -s -X GET \
        "${VULTR_API_BASE}/instances" \
        -H "Authorization: Bearer ${VULTR_API_KEY}")

    local instance_id
    instance_id=$(echo "$instances" | jq -r ".instances[] | select(.label == \"${instance_name}\") | .id" 2>/dev/null || echo "")

    if [[ -z "$instance_id" ]]; then
        log_error "VM not found. Create it first:"
        echo "  ./cloud-providers/vultr/create-vm.sh"
        return 1
    fi

    # Get current status
    local status
    status=$(echo "$instances" | jq -r ".instances[] | select(.label == \"${instance_name}\") | .status")

    case "$status" in
        active)
            log_success "VM is already running."
            return 0
            ;;
        stopped)
            log_info "VM is stopped. Starting..."
            curl -s -X POST \
                "${VULTR_API_BASE}/instances/${instance_id}/start" \
                -H "Authorization: Bearer ${VULTR_API_KEY}" > /dev/null
            log_success "VM start command sent."
            ;;
        *)
            log_warning "VM status: $status"
            ;;
    esac

    # Wait for active
    if [[ "$status" != "active" ]]; then
        log_info "Waiting for VM to start..."
        local elapsed=0
        while [[ $elapsed -lt $START_TIMEOUT ]]; do
            local check
            check=$(curl -s -X GET \
                "${VULTR_API_BASE}/instances/${instance_id}" \
                -H "Authorization: Bearer ${VULTR_API_KEY}")

            status=$(echo "$check" | jq -r '.instance.status')

            if [[ "$status" == "active" ]]; then
                log_success "VM is running!"
                return 0
            fi

            echo -n "."
            sleep 2
            elapsed=$((elapsed + 2))
        done
        echo ""
        log_error "VM failed to start within timeout."
        return 1
    fi
}

# Main
echo -e "${GREEN}"
echo "=================================="
echo "Portable CC - Start VM"
echo "=================================="
echo -e "${NC}"
echo "Provider:  $PROVIDER_NAME ($CLOUD_PROVIDER)"
echo "Instance:  $INSTANCE_NAME"
echo ""

# Start the VM
case "$CLOUD_PROVIDER" in
    gcp)
        if ! gcp_start_vm "$PROJECT_ID" "$ZONE" "$INSTANCE_NAME"; then
            exit 1
        fi
        ;;
    vultr)
        if ! vultr_start_vm "$INSTANCE_NAME"; then
            exit 1
        fi
        ;;
    *)
        log_error "Unknown provider: $CLOUD_PROVIDER"
        exit 1
        ;;
esac

# Check for Tailscale host
TAILSCALE_HOST="${TAILSCALE_HOST:-}"
SSH_USER="${SSH_USER:-ubuntu}"

if [[ -z "$TAILSCALE_HOST" ]]; then
    log_warning "TAILSCALE_HOST not set."
    echo ""
    echo "Please set your Tailscale hostname or IP:"
    echo "  export TAILSCALE_HOST='your-tailscale-host-or-ip'"
    echo ""
    read -p "Enter Tailscale hostname/IP (or press Enter to skip): " TAILSCALE_HOST_INPUT
    TAILSCALE_HOST="$TAILSCALE_HOST_INPUT"
fi

if [[ -z "$TAILSCALE_HOST" ]]; then
    log_info "Skipping SSH connection. VM is running."
    log_info "Connect manually when ready:"
    echo "  mosh $SSH_USER@<tailscale-ip>"
    exit 0
fi

# Wait for SSH
log_info "Waiting for SSH connectivity..."
local elapsed=0
while [[ $elapsed -lt $SSH_TIMEOUT ]]; do
    if ssh -o ConnectTimeout=5 -o StrictHostKeyChecking=no "$SSH_USER@$TAILSCALE_HOST" "echo ready" &>/dev/null; then
        log_success "SSH is ready!"
        break
    fi
    echo -n "."
    sleep 2
    elapsed=$((elapsed + 2))
done
echo ""

# Connect
log_info "Connecting to $TAILSCALE_HOST..."
if command -v mosh &> /dev/null; then
    exec mosh "$SSH_USER@$TAILSCALE_HOST"
else
    log_warning "mosh not found. Using SSH."
    exec ssh "$SSH_USER@$TAILSCALE_HOST"
fi
