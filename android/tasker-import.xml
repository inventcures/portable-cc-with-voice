      <Str>url</Str>
      <Str>%CLOUD_FUNCTION_URL</Str>
      <Int>1</Int>
      <Str>method</Str>
      <Str>GET</Str>
      <Str>headers</Str>
      <Array>
        <Str>Content-Type: application/json</Str>
        <Str>X-API-Key: %API_KEY</Str>
      </Array>
      <Int>0</Int>
      <Str>output</Str>
      <Int>3</Int>
      <Int>0</Int>
    </Action>
    <Action>
      <code>Variable Search Replace</code>
      <sr>act1</sr>
      <Str>ignore</Str>
      <Str>search</Str>
      <Str>"status":"(.*?)"</Str>
      <Str>replace</Str>
      <Int>1</Int>
      <Str>store</Str>
      <Str>status</Str>
      <Int>0</Int>
      <Int>0</Int>
    </Action>
    <Action>
      <code>Flash</code>
      <sr>act2</sr>
      <Str>VM Status: %status</Str>
      <Int>1</Int>
    </Action>
  </Task>

